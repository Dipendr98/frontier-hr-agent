# ---------------------------------------------------------------------------
# LLM provider configuration.  Copy to `.env` — it is gitignored.
#
# LEAVE EVERYTHING BLANK to run Mode 1 and reproduce every headline number with
# zero API keys. The deterministic pipeline needs no provider, so judges can
# reproduce the full BASELINE / BASELINE+ / AGENT comparison without credentials.
#
# Set a provider to enable:
#   - Mode 1's optional prose layer (changes wording, never a decision)
#   - Mode 2  the genuine LLM tool-calling agent
#   - Mode 3  the same agent with every claim re-derived and verified
#
# After setting anything here, check it end to end:
#
#     python -m advanced.doctor
#
# That verifies the key authenticates AND that the model actually emits tool
# calls AND that it is fast enough for an agent loop — three different things,
# and a model can pass the first while failing the others silently.
# ---------------------------------------------------------------------------

# --- Option 1: use a preset (easiest) --------------------------------------
# Each preset sets a base_url and a default model already checked for
# tool-calling support and latency.

# LLM_PRESET=nvidia
# LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
#   default model: nvidia/nemotron-3-super-120b-a12b
#   Free tier rate-limits aggressively — see LLM_MAX_CONCURRENCY below.

# LLM_PRESET=gemini
# LLM_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx
#   default model: gemini-2.0-flash

# LLM_PRESET=groq
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
#   default model: llama-3.3-70b-versatile

# LLM_PRESET=openrouter
# LLM_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
#   default model: meta-llama/llama-3.3-70b-instruct

# LLM_PRESET=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
#   default model: gpt-4o-mini

# LLM_PRESET=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
#   default model: claude-sonnet-4-6  (native API, not OpenAI-compatible)

# LLM_PRESET=ollama            # local, no key needed

# Optional: override the preset's default model.
# Pick a model that supports tool calling if you want Modes 2/3 — `doctor`
# will tell you if it does not.
# LLM_MODEL=openai/gpt-oss-120b


# --- Option 2: fully manual (any OpenAI-compatible endpoint) ---------------
# NVIDIA NIM, Gemini's OpenAI-compat endpoint, Groq, OpenRouter, Together,
# local vLLM or Ollama — only base_url, key and model change.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b


# --- Option 3: Anthropic (native API) --------------------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-sonnet-4-6


# --- Reliability knobs -----------------------------------------------------

# Per-request timeout, seconds.
# LLM_TIMEOUT=90

# Retries on transient failures (429/5xx/timeouts). A 401 or 400 is never
# retried — that only hides the cause.
# LLM_MAX_RETRIES=6

# Client-side throttle. Agent loops are many short sequential calls, which is
# exactly the traffic shape that trips free-tier rate limits. Self-limiting
# beats discovering the limit by hitting it. Raise these if your account allows.
# LLM_MAX_CONCURRENCY=2
# LLM_MIN_INTERVAL=0.35

# Mode 1's optional prose layer. On by default for single cases, and switched
# off by the batch entry points (evaluate.py, cohort triage) because it costs
# one completion per agent per case and changes no decision.
# LLM_NARRATE=1

# Escape hatch for provider-specific request fields, as JSON. The nvidia preset
# already sets {"chat_template_kwargs": {"thinking": false}} to stop reasoning
# models spilling their chain of thought into the reviewer-facing text.
# LLM_EXTRA_BODY={"top_p": 0.9}
